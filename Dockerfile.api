# =========================================================
# Dockerfile - API .NET 8 (Build context = solution root)
# =========================================================

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copier les fichiers projet pour restaurer les packages
COPY GestionCompteurs.Domain/GestionCompteurs.Domain.csproj         GestionCompteurs.Domain/
COPY GestionCompteurs.Application/GestionCompteurs.Application.csproj GestionCompteurs.Application/
COPY GestionCompteurs.Infrastructure/GestionCompteurs.Infrastructure.csproj GestionCompteurs.Infrastructure/
COPY GestionCompteurs.API/GestionCompteurs.API.csproj               GestionCompteurs.API/

RUN dotnet restore GestionCompteurs.API/GestionCompteurs.API.csproj

# Copier tout le code source
COPY GestionCompteurs.Domain/         GestionCompteurs.Domain/
COPY GestionCompteurs.Application/    GestionCompteurs.Application/
COPY GestionCompteurs.Infrastructure/ GestionCompteurs.Infrastructure/
COPY GestionCompteurs.API/            GestionCompteurs.API/

WORKDIR /src/GestionCompteurs.API
RUN dotnet publish GestionCompteurs.API.csproj -c Release -o /app/publish

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

EXPOSE 80

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "GestionCompteurs.API.dll"]
